# 复制为 .env 后按本机情况修改
APP_ENV=dev
APP_PORT=8090

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=blog
DB_PASSWORD=请填写你的数据库密码
DB_NAME=blog
DB_CHARSET=utf8mb4
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

JWT_SECRET=请用 openssl rand -hex 32 生成一个
JWT_EXPIRE_HOURS=24

UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5
DB_CONN_MAX_LIFETIME_MIN=30
