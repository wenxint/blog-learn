# Go 编译产物
backend/server
backend/backend
*.exe
*.log

# 环境变量（含密码，绝对不能提交）
backend/.env
# 各环境的真实配置（.env.prod / .env.local 等）同样含密钥，一律不入库
backend/.env.*
# 但模板要提交，方便别人知道要配哪些项
!backend/.env.example

# 上传的图片
backend/uploads/

# Node
frontend/node_modules/
frontend/dist/

# 系统/编辑器
.DS_Store
.idea/
.vscode/
# SQLTools 临时会话文件（每台机器各自生成）
*.session.sql

# Go 编译产物目录
backend/bin/
